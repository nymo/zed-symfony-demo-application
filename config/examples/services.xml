<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="demo.xml.consumer" class="App\HelloWorld\ServiceConsumer">
            <argument type="service" id="hello.world.generator" />
            <tag name="app.greeting_consumer" />
        </service>
        <service id="demo.xml.generator_alias" alias="hello.world.generator" />
    </services>
</container>
